{
  "lumine-text-editor:not([mini])": {
    "cmdorctrl-k shift-c": "code-format:format-code"
  },
  ".code-format-observed-files-list lumine-text-editor[mini]": {
    "cmdorctrl-d": "code-format:unobserve-selected-file",
    "alt-enter": "code-format:open",
    "ctrl-alt-enter": "code-format:open-external",
    "alt-shift-enter": "code-format:show-in-folder"
  }
}
